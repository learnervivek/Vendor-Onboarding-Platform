{
  "name": "@edvexa/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "build": "node --check src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "lint": "eslint . --ext .js",
    "check": "node --check src/server.js",
    "test": "node --test --test-concurrency=1 --test-force-exit tests/*.test.js",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand tests/jest/api.test.js",
    "test:all": "npm run test && npm run test:jest",
    "seed": "node src/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.66.0",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0"
  }
}
