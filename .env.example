# Backend
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/edvexa_vendor_onboarding
# Jest integration tests use an isolated MongoDB Memory Server by default.
TEST_MONGODB_URI=
COOKIE_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
LOG_LEVEL=info
QUEUE_ADAPTER=redis
REDIS_URL=redis://127.0.0.1:6379
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=1000
WORKER_POLL_MS=5000
EMAIL_PREVIEW_PATH=./backend/.data/email-previews

# Frontend
VITE_API_URL=http://localhost:4000/api/v1

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/private
# Set STORAGE_PROVIDER=cloudinary and provide these in hosted environments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
